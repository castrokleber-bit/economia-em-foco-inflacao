# Copie para .env e preencha. .env NÃO vai para o git.

# Chave da API Anthropic — usada APENAS no rascunho de "leitura para a indústria".
# Se vazia, o app funciona normalmente, só sem o rascunho.
ANTHROPIC_API_KEY=

# Projeção CNI do IPCA do mês (ex.: 0.67). Opcional; pode vir de config/projecoes.json.
PROJECAO_CNI_IPCA=

# Assinatura institucional padrão da nota (definir um único padrão — ver ESPECIFICACAO 5.3)
ASSINATURA=Superintendência de Economia (ECON)
